# Beta environment for NextBiz One — copy to .env.beta (untracked) and fill.
# Deployed by: scripts/deploy.sh --env beta (systemd timer, every 5 min).
# NEVER commit .env.beta — it is gitignored; secrets stay out of the repo.

# Postgres (beta db container: nextbiz_one_beta_db) — generate a fresh
# password for beta; never reuse the prod one.
DB_PASSWORD=<generate: openssl rand -hex 16>
DATABASE_URL=postgres://nextbiz:<DB_PASSWORD>@one-beta-db:5432/nextbiz_one

# Operator login — same as prod (internal testing login)
OPERATOR_EMAIL=<same as prod .env>
OPERATOR_PASS=<same as prod .env>

# WhatsApp / Meta — STUBBED on beta: beta must never message real customers
# or hit live Meta APIs (inbound webhooks route to prod only).
WHATSAPP_VERIFY_TOKEN=beta-stub-verify-token
WHATSAPP_APP_SECRET=beta-stub-app-secret
META_ACCESS_TOKEN=beta-stub-access-token
# identifiers only — no send is possible with the stub token above
WABA_ID=<same as prod>
PHONE_NUMBER_ID=<same as prod>
META_BUSINESS_ID=<same as prod>
META_APP_ID=<same as prod>
